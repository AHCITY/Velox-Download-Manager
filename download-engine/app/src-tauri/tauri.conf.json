{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velox",
  "mainBinaryName": "Velox",
  "version": "0.2.0",
  "identifier": "io.velox.downloadmanager",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Velox \u2014 Download Manager",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'",
      "capabilities": [
        "main-cap"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "publisher": "Velox Project (unsigned development build)",
    "copyright": "MIT License",
    "shortDescription": "Fast, resumable multi-connection download manager",
    "longDescription": "Velox is a native desktop download manager powered by a multi-connection Rust download engine with crash recovery, integrity verification and persistent history."
  }
}