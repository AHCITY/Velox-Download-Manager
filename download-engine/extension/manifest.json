{
  "manifest_version": 3,
  "name": "Velox Download Manager",
  "version": "1.0.0",
  "description": "Official Velox companion \u2014 send downloads to the Velox desktop app, watch speed and progress.",
  "key": "",
  "action": {
    "default_title": "Velox Download Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "contextMenus",
    "notifications",
    "alarms",
    "storage",
    "downloads",
    "nativeMessaging"
  ],
  "optional_permissions": [
    "clipboardRead"
  ],
  "host_permissions": [],
  "minimum_chrome_version": "102"
}
